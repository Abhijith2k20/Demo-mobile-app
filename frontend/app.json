{
  "expo": {
    "name": "Siteline",
    "slug": "siteline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.siteline.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B2430",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.siteline.mobile",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Siteline uses the microphone to record voice notes for your team.",
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1667B0",
          "defaultChannel": "default"
        }
      ]
    ],
    "scheme": "siteline",
    "experiments": {
      "typedRoutes": false
    }
  }
}
