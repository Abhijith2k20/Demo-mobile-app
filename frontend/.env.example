# App settings. Copy to frontend/.env for local runs (git ignores .env):  cp .env.example .env
# Expo reads EXPO_PUBLIC_* variables at build time. They end up inside the app, so never put a secret here.

# The backend API address. Leave unset locally: the app uses the computer running Expo on port 8000
# (Android emulator: run `adb reverse tcp:8000 tcp:8000`). Builds and updates get it from the Expo dashboard
# (Environment variables: preview = https://staging-api.siteline.app, production = https://api.siteline.app).
# EXPO_PUBLIC_API_URL=http://192.168.1.2:8000
