# Backend settings. Copy to backend/.env for local runs (git ignores .env):  cp .env.example .env
# Start the API with:  .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --env-file .env
# On Render these are set in the dashboard instead (render.yaml lists them). Never commit real values.

# Required. development | staging | production. Without it the server won't start.
SITELINE_ENV=development

# --- Optional in development (safe local defaults are used); required on staging and production ---
# Long random value (32+ characters): signs sessions and encrypts PM keys. Keep it fixed once set.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# SITELINE_SECRET=
# Key for POST /platform/companies (X-Platform-Key header). 24+ random characters.
# SITELINE_PLATFORM_KEY=
# Emails allowed into the platform panel at /platform, comma-separated.
# SITELINE_PLATFORM_ADMINS=you@siteline.app

# Postgres. Default: the docker compose database on port 5433.
# DATABASE_URL=postgresql://siteline:siteline@localhost:5433/siteline
# This API's public address, used in invite emails and file links. Production: https://api.siteline.app
# SITELINE_PUBLIC_URL=http://localhost:8000

# --- Files: local disk by default; production needs Cloudflare R2 ---
# SITELINE_STORAGE=local
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# --- Email (sign-in codes, invites). Without a key, development prints codes in the log ---
# RESEND_API_KEY=
# EMAIL_FROM=Siteline <no-reply@siteline.app>

# --- Push notifications and error tracking (optional) ---
# EXPO_ACCESS_TOKEN=
# SENTRY_DSN=

# --- Development only ---
# SITELINE_DEMO=0        # turn off seed data, scripted teammates and the dev panel's /internal routes
